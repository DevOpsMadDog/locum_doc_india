{
  "info": {
    "name": "LocumMap Chennai API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Request OTP",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/auth/otp/request",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone\": \"+919900000001\"\n}"
        }
      }
    },
    {
      "name": "Verify OTP",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/auth/otp/verify",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone\": \"+919900000001\",\n  \"otp\": \"123456\",\n  \"role\": \"clinic_admin\"\n}"
        }
      }
    },
    {
      "name": "Create Shift",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": "{{baseUrl}}/clinics/shifts",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"specialty\": \"dentist_general\",\n  \"start_time\": \"2024-09-05T09:00:00Z\",\n  \"end_time\": \"2024-09-05T13:00:00Z\",\n  \"pay_amount\": 4500,\n  \"address\": \"T Nagar, Chennai\",\n  \"lat\": 13.04,\n  \"lng\": 80.23,\n  \"notes\": \"Bring toolkit\"\n}"
        }
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000" },
    { "key": "token", "value": "" }
  ]
}
